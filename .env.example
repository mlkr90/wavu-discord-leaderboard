# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Your Discord user ID (right-click yourself → Copy User ID with Developer Mode on)
OWNER_ID=123456789012345678

# Optional: your server (guild) ID for instant slash command sync during development.
# Leave blank or remove for global sync (takes up to 1 hour to propagate).
GUILD_ID=987654321098765432
